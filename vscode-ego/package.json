{
  "name": "ego-trainer",
  "displayName": "Ego Trainer",
  "description": "Practice tasks for junior developers — check, pull, push progress",
  "version": "0.1.0",
  "publisher": "ego-trainer",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ego.login",
        "title": "Ego: Login",
        "category": "Ego"
      },
      {
        "command": "ego.setServer",
        "title": "Ego: Set Server URL",
        "category": "Ego"
      },
      {
        "command": "ego.check",
        "title": "Ego: Check Current Task",
        "category": "Ego"
      },
      {
        "command": "ego.pull",
        "title": "Ego: Pull Tasks",
        "category": "Ego"
      },
      {
        "command": "ego.pullAll",
        "title": "Ego: Pull All Tasks",
        "category": "Ego"
      },
      {
        "command": "ego.list",
        "title": "Ego: List Tasks",
        "category": "Ego"
      },
      {
        "command": "ego.showTask",
        "title": "Ego: Show Task Statement",
        "category": "Ego"
      },
      {
        "command": "ego.hints",
        "title": "Ego: Show Hints",
        "category": "Ego"
      },
      {
        "command": "ego.myProgress",
        "title": "Ego: My Progress",
        "category": "Ego"
      },
      {
        "command": "ego.push",
        "title": "Ego: Push Progress to Server",
        "category": "Ego"
      },
      {
        "command": "ego.refreshTree",
        "title": "Ego: Refresh Task List",
        "icon": "$(refresh)"
      },
      {
        "command": "ego.openTask",
        "title": "Ego: Open Task",
        "category": "Ego"
      },
      {
        "command": "ego.showWelcome",
        "title": "Ego: Show Welcome",
        "category": "Ego"
      },
      {
        "command": "ego.init",
        "title": "Ego: Init",
        "category": "Ego"
      },
      {
        "command": "ego.dashboard",
        "title": "Ego: Dashboard",
        "category": "Ego"
      },
      {
        "command": "ego.openTaskView",
        "title": "Ego: Open Task View",
        "category": "Ego"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "egoTaskTree",
          "name": "Ego Tasks",
          "when": "ego.ready || ego.loggedIn"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ego.refreshTree",
          "when": "view == egoTaskTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ego.openTask",
          "when": "view == egoTaskTree && viewItem == task",
          "group": "inline"
        },
        {
          "command": "ego.check",
          "when": "view == egoTaskTree && viewItem == task",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Ego",
      "properties": {
        "ego.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Ego server URL (e.g. http://localhost:8000 or https://ego.example.com)",
          "scope": "resource"
        },
        "ego.autoCheckOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run check when saving a task .py file",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.webview.mjs",
    "compile:ext": "tsc -p ./",
    "compile:webview": "node esbuild.webview.mjs",
    "watch": "tsc -watch -p ./ & node esbuild.webview.mjs --watch",
    "watch:ext": "tsc -watch -p ./",
    "watch:webview": "node esbuild.webview.mjs --watch",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "svelte": "^5.56.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "marked": "^18.0.6"
  }
}
