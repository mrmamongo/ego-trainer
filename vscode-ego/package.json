{
  "name": "ego-trainer",
  "displayName": "Cogito",
  "description": "Cogito: тренажёр для начинающих разработчиков — решай задачи, проверяй код и отслеживай прогресс",
  "version": "0.2.5",
  "publisher": "ego-trainer",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ego.assistant",
        "title": "Учебный ассистент",
        "category": "Cogito"
      },
      {
        "command": "ego.login",
        "title": "Войти",
        "category": "Cogito"
      },
      {
        "command": "ego.logout",
        "title": "Выйти",
        "category": "Cogito"
      },
      {
        "command": "ego.setServer",
        "title": "Указать адрес сервера",
        "category": "Cogito"
      },
      {
        "command": "ego.setupPython",
        "title": "Настроить Python",
        "category": "Cogito"
      },
      {
        "command": "ego.checkUpdate",
        "title": "Проверить обновления",
        "category": "Cogito"
      },
      {
        "command": "ego.check",
        "title": "Проверить текущую задачу",
        "category": "Cogito"
      },
      {
        "command": "ego.checkTask",
        "title": "Проверить задачу",
        "category": "Cogito"
      },
      {
        "command": "ego.pull",
        "title": "Скачать задачи",
        "category": "Cogito"
      },
      {
        "command": "ego.pullAll",
        "title": "Скачать все задачи",
        "category": "Cogito"
      },
      {
        "command": "ego.pullAllForce",
        "title": "Перескачать все задачи",
        "category": "Cogito"
      },
      {
        "command": "ego.pullTask",
        "title": "Скачать задачу",
        "category": "Cogito"
      },
      {
        "command": "ego.list",
        "title": "Список задач",
        "category": "Cogito"
      },
      {
        "command": "ego.showTask",
        "title": "Показать условие",
        "category": "Cogito"
      },
      {
        "command": "ego.hints",
        "title": "Показать подсказки",
        "category": "Cogito"
      },
      {
        "command": "ego.hintsForTask",
        "title": "Подсказки к задаче",
        "category": "Cogito"
      },
      {
        "command": "ego.myProgress",
        "title": "Мой прогресс",
        "category": "Cogito"
      },
      {
        "command": "ego.push",
        "title": "Отправить прогресс на сервер",
        "category": "Cogito"
      },
      {
        "command": "ego.refreshTree",
        "category": "Cogito",
        "title": "Обновить список задач",
        "icon": "$(refresh)"
      },
      {
        "command": "ego.openTask",
        "title": "Открыть задачу",
        "category": "Cogito"
      },
      {
        "command": "ego.openLesson",
        "title": "Открыть теорию",
        "category": "Cogito"
      },
      {
        "command": "ego.showWelcome",
        "title": "Приветствие",
        "category": "Cogito"
      },
      {
        "command": "ego.init",
        "title": "Подключить папку к курсу",
        "category": "Cogito"
      },
      {
        "command": "ego.dashboard",
        "title": "Личный кабинет",
        "category": "Cogito"
      },
      {
        "command": "ego.openTaskView",
        "title": "Открыть панель задания",
        "category": "Cogito"
      },
      {
        "command": "ego.switchMode",
        "title": "Переключить режим (сервер / локально)",
        "category": "Cogito"
      }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "cogito", "title": "Cogito", "icon": "media/cogito.svg" }],
      "secondarySidebar": [{ "id": "cogito-assistant", "title": "Cogito · Ассистент", "icon": "$(comment-discussion)" }]
    },
    "views": {
      "cogito": [
        {
          "id": "egoTaskTree",
          "name": "Задачи",
          "icon": "media/cogito.svg",
          "initialSize": 30
        },
        {
          "id": "egoTaskDetail",
          "type": "webview",
          "name": "Задание",
          "icon": "$(book)",
          "initialSize": 70
        }
      ],
      "cogito-assistant": [
        { "id": "egoAssistant", "type": "webview", "name": "Учебный ассистент", "icon": "$(comment-discussion)" }
      ]
    },
    "viewsWelcome": [
      { "view": "egoTaskTree", "contents": "Решай задачи, проверяй код и обсуждай решение с ассистентом.\n[Подключиться или настроить](command:ego.init)\n[Войти в Cogito](command:ego.login)", "when": "!ego.ready && !ego.loggedIn" },
      { "view": "egoTaskTree", "contents": "Задач пока нет.\n[Загрузить задачи](command:ego.pullAll)\n[Открыть обзор](command:ego.dashboard)", "when": "ego.ready || ego.loggedIn" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ego.refreshTree",
          "when": "view == egoTaskTree",
          "group": "navigation"
        },
        { "command": "ego.dashboard", "when": "view == egoTaskTree", "group": "navigation@2" },
        { "command": "ego.login", "when": "view == egoTaskTree && !ego.loggedIn && !ego.offline", "group": "navigation@3" },
        { "command": "ego.logout", "when": "view == egoTaskTree && ego.loggedIn && !ego.offline", "group": "navigation@4" }
      ],
      "view/item/context": [
        {
          "command": "ego.assistant",
          "when": "view == egoTaskTree && viewItem == task && ego.aiEnabled && !ego.offline",
          "group": "1_actions@3"
        },
        {
          "command": "ego.openTask",
          "when": "view == egoTaskTree && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "ego.checkTask",
          "when": "view == egoTaskTree && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "ego.hintsForTask",
          "when": "view == egoTaskTree && viewItem == task",
          "group": "1_actions@1"
        },
        {
          "command": "ego.pullTask",
          "when": "view == egoTaskTree && viewItem == task && !ego.offline",
          "group": "1_actions@2"
        }
      ]
    },
    "configuration": {
      "title": "Cogito",
      "properties": {
        "ego.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Адрес сервера Cogito (например, http://localhost:8000 или https://cogito.example.com)",
          "scope": "resource"
        },
        "ego.autoCheckOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Автоматически проверять задачу при сохранении её .py-файла",
          "scope": "resource"
        },
        "ego.pythonPackageSpec": {
          "type": "string",
          "default": "ego-trainer",
          "description": "Python-пакет для проверок Cogito: опубликованный пакет или доверенный локальный путь либо URL",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.webview.mjs && node esbuild.extension.mjs",
    "compile:ext": "node esbuild.extension.mjs",
    "compile:webview": "node esbuild.webview.mjs",
    "compile:test": "tsc -p ./",
    "watch": "tsc -watch -p ./ & node esbuild.webview.mjs --watch & node esbuild.extension.mjs --watch",
    "watch:ext": "node esbuild.extension.mjs --watch",
    "watch:webview": "node esbuild.webview.mjs --watch",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "node --test out/test/*.test.js",
    "smoke": "node ./scripts/smoke-activation.cjs && node ./scripts/smoke-forgejo-login.cjs && node ./scripts/smoke-sidebars.cjs",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "svelte": "^5.56.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "marked": "^18.0.6"
  }
}
