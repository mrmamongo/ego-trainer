.vscode/**
.vscode-test/**
src/**
# Exclude dev-only packages so the runtime dependency `marked` (and its
# runtime dependency tree) ships inside the .vsix. Build tooling, type defs,
# and the Svelte/esbuild pipeline are not needed at runtime.
node_modules/@types/**
node_modules/esbuild/**
node_modules/esbuild-svelte/**
node_modules/svelte/**
node_modules/typescript/**
out/**/*.map
out/**/*.d.ts
tsconfig.json
esbuild.webview.mjs
.gitignore
